---
layout: layout.njk
wide: true
---
{#
    The home page. Its wording comes from the front matter of the page that uses this layout
    (src/index.njk in English, src/ar/index.njk in Arabic), so the two languages always have the same
    structure. Text may hold HTML; "{price}", "{additional}", "{documents}" and "{extra}" in it become
    the monthly price for the first legal entity, the monthly price for each further one, the
    documents included across all of a customer's legal entities and the price of each further document, and "{discount}" and "{months}" the
    introductory monthly discount on the first legal entity and the months it lasts (site.json),
    "{intro}" the monthly price less that discount, and "{app}"
    the address of the app in this page's language (strings.json).

    `trial` is set while the app is open for testing only: it adds the badge and the note, and names
    the buttons that open the app. Without it they read cta.button.
#}
{%- set app = strings[lang or "en"].app %}
{%- set intro = (site.price | int) - (site.discount | int) %}
{%- macro t(text) %}{{ text | replace("{price}", site.price) | replace("{additional}", site.additional) | replace("{discount}", site.discount) | replace("{months}", site.months) | replace("{intro}", intro) | replace("{documents}", site.documents) | replace("{extra}", site.extra) | replace("{app}", app) | safe }}{% endmacro %}
<section class="hero">
    {%- if trial %}
    <p class="soon-badge">{{ t(trial.badge) }}</p>
    {%- endif %}
    <p class="hero-kicker">{{ t(hero.kicker) }}</p>
    <h1>{{ t(hero.title) }}</h1>
    <p>{{ t(hero.text) }}</p>
    <div class="hero-actions">
        <a href="{{ app }}" class="btn btn-lg">{{ t(trial.button if trial else cta.button) }}</a>
        <a href="#pricing" class="btn btn-secondary btn-lg">{{ t(hero.pricing) }}</a>
    </div>
    <p class="hero-note">{{ t(hero.note) }}</p>
</section>

<section class="section" id="how-it-works">
    <div class="container">
        <h2 class="section-title">{{ t(how.title) }}</h2>
        <p class="section-lead">{{ t(how.lead) }}</p>
        <ol class="steps">
            {%- for step in how.steps %}
            <li>
                <h3>{{ t(step.title) }}</h3>
                <p>{{ t(step.description) }}</p>
            </li>
            {%- endfor %}
        </ol>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <h2 class="section-title">{{ t(features.title) }}</h2>
        <div class="feature-grid">
            {%- for feature in features.list %}
            <div class="feature">
                <h3>{{ t(feature.title) }}</h3>
                <p>{{ t(feature.description) }}</p>
            </div>
            {%- endfor %}
        </div>
    </div>
</section>

<section class="section" id="deadlines">
    <div class="container">
        <h2 class="section-title">{{ t(deadlines.title) }}</h2>
        <p class="section-lead">{{ t(deadlines.lead) }}</p>
        <ol class="deadlines">
            {%- for deadline in deadlines.list %}
            <li>
                <div class="deadline-date">{{ t(deadline.date) }}</div>
                <div>
                    <h3>{{ t(deadline.who) }}</h3>
                    <p>{{ t(deadline.what) }}</p>
                </div>
            </li>
            {%- endfor %}
        </ol>
        <p class="section-note">{{ t(deadlines.note) }}</p>
    </div>
</section>

<section class="section section-alt" id="pricing">
    <div class="container">
        <h2 class="section-title">{{ t(pricing.title) }}</h2>
        <p class="section-lead">{{ t(pricing.lead) }}</p>
        <div class="price-card">
            {#- With an introductory discount (site.discount) the card leads with the discounted price
                and crosses out the full one. #}
            {%- if site.discount %}
            <p class="price-badge">{{ t(pricing.badge) }}</p>
            {%- endif %}
            <div class="price">
                <span class="price-currency">{{ t(pricing.currency) }}</span>
                {%- if site.discount %}
                <s class="price-was">{{ site.price }}</s>
                <span class="price-amount">{{ intro }}</span>
                {%- else %}
                <span class="price-amount">{{ site.price }}</span>
                {%- endif %}
            </div>
            <p class="price-unit">{{ t(pricing.unit) }}</p>
            {%- if site.discount %}
            <p class="price-then">{{ t(pricing.then) }}</p>
            {%- endif %}
            <dl class="price-rows">
                {%- for row in pricing.rows %}
                <div>
                    <dt>{{ t(row.label) }}</dt>
                    <dd>{{ t(row.value) }}</dd>
                </div>
                {%- endfor %}
            </dl>
            <ul class="checklist">
                {%- for item in pricing.included %}
                <li>{{ t(item) }}</li>
                {%- endfor %}
            </ul>
            {%- if trial %}
            <p class="soon-note">{{ t(trial.note) }}</p>
            {%- endif %}
            <a href="{{ app }}" class="btn btn-lg">{{ t(trial.button if trial else cta.button) }}</a>
        </div>
    </div>
</section>

<section class="section" id="faq">
    <div class="container">
        <h2 class="section-title">{{ t(faq.title) }}</h2>
        <div class="faq">
            {%- for item in faq.list %}
            <details>
                <summary>{{ t(item.question) }}</summary>
                <p>{{ t(item.answer) }}</p>
            </details>
            {%- endfor %}
            <details>
                <summary>{{ t(faq.help) }}</summary>
                <p>{{ t(faq.helpAnswer) }} <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
            </details>
        </div>
    </div>
</section>

<section class="cta">
    <h2>{{ t(cta.title) }}</h2>
    <p>{{ t(cta.text) }}{% if trial %}<br>{{ t(trial.note) }}{% endif %}</p>
    <a href="{{ app }}" class="btn btn-lg">{{ t(trial.button if trial else cta.button) }}</a>
</section>
